    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "def load_tables():\n",
    "\n",
    "    data_path = Path(r\"D:\\RCM\")\n",
    "\n",
    "    tables = {}\n",
    "\n",
    "    for file in data_path.glob(\"*.csv\"):\n",
    "\n",
    "        tables[file.stem] = pd.read_csv(file)\n",
    "\n",
    "    return tables"
   ]
